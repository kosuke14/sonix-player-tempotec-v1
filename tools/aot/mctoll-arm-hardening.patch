+/// The register-offset form of the PC-relative load: ldr rX, [pc, rY]. The
+/// obfuscated code always prepares rY with an immediate load from the
+/// literal pool right before, and the pool entry is the address the load
+/// wants. Reading that entry here gives the data address straight away.
+void ARMMIRevising::addressPCRelativeRegisterData(MachineInstr &MInst) {
+  if (MInst.getNumOperands() < 3 || !MInst.getOperand(2).isReg()) {
+    return;
+  }
+  Register OffReg = MInst.getOperand(2).getReg();
+
+  // Find the instruction that defines the offset register within this block:
+  // a literal-pool load whose own PC-relative data is the pool entry.
+  int64_t PoolEntryValue = -1;
+  for (MachineBasicBlock::iterator PIit = MInst.getParent()->begin();
+       &*PIit != &MInst; ++PIit) {
+    MachineInstr &PI = *PIit;
+    if (&PI == &MInst) {
+      continue;
+    }
+    if (PI.getOpcode() == ARM::LDRi12 && PI.getNumOperands() >= 2 &&
+        PI.getOperand(0).isReg() && PI.getOperand(0).getReg() == OffReg &&
+        PI.getOperand(1).isReg() && PI.getOperand(1).getReg() == ARM::PC) {
+      // The pool entry holds the address; its own PC-relative data sits at
+      // the load's address plus the immediate, and the four bytes there are
+      // the offset the register form adds.
+      int64_t MCInstOffset = getMCInstIndex(PI);
+      int64_t Imm = PI.getNumOperands() > 2 && PI.getOperand(2).isImm()
+                        ? PI.getOperand(2).getImm()
+                        : 0;
+      int64_t EntryAddr =
+          MR->getTextSectionAddress() + MCInstOffset + 8 + Imm;
+      // Read the four bytes at EntryAddr from the object file's sections.
+      const ELF32LEObjectFile *ObjFile =
+          dyn_cast<ELF32LEObjectFile>(MR->getObjectFile());
+      if (ObjFile == nullptr) {
+        return;
+      }
+      for (section_iterator Sec : ObjFile->sections()) {
+        uint64_t SecStart = Sec->getAddress();
+        uint64_t SecEnd = SecStart + Sec->getSize();
+        if (EntryAddr >= SecStart && EntryAddr + 4 <= SecEnd) {
+          auto ContentsOrErr = Sec->getContents();
+          if (!ContentsOrErr) {
+            consumeError(ContentsOrErr.takeError());
+            return;
+          }
+          StringRef Data = *ContentsOrErr;
+          size_t Off = (size_t)(EntryAddr - SecStart);
+          PoolEntryValue = (int64_t)(uint32_t)(
+              (uint8_t)Data[Off] | ((uint8_t)Data[Off + 1] << 8) |
+              ((uint8_t)Data[Off + 2] << 16) | ((uint8_t)Data[Off + 3] << 24));
+          break;
+        }
+      }
+      if (PoolEntryValue >= 0) {
+        break;
+      }
+    }
+  }
+  if (PoolEntryValue < 0) {
+    return;
+  }
+
+  // The data address is PC of this instruction + 8 + the pool value; find
+  // the symbol that names it and rewrite the load to the immediate form so
+  // the LDRi12 path takes it from here.
+  int64_t MCInstOffset = getMCInstIndex(MInst);
+  const Value *GlobVal = getGlobalValueByOffset(
+      MCInstOffset, (uint64_t)PoolEntryValue + 8);
+  if (GlobVal == nullptr) {
+    return;
+  }
+  fprintf(stderr, "DBG addrPCReg: %s\n", GlobVal->getName().data());
+  MInst.getOperand(1).ChangeToES(GlobVal->getName().data());
+  if (MInst.getNumOperands() > 2) {
+    MInst.removeOperand(2);
+  }
+  if (MInst.getOpcode() == ARM::LDRrs) {
+    // The shifted-register operand is gone; the opcode becomes the simple
+    // immediate form the rest of the raiser understands.
+    MInst.setDesc(MR->getMCInstrInfo()->get(ARM::LDRi12));
+    MInst.addOperand(MachineOperand::CreateImm(0));
+  }
+}
